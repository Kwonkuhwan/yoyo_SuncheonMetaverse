--- !u!114 &6548594491422394965
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7421067148082392264}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB098\uBE44\uB4E4\uC740 \uC8FC\uB85C \uBC24\uC5D0 \uD734\uC2DD\uC744
    \uCDE8\uD569\uB2C8\uB2E4. \uD734\uC2DD \uC911\uC5D0\uB294 \uB098\uBE44\uC758
    \uB0A0\uAC1C\uAC00 \uC811\uD600 \uC788\uACE0\n\uBA38\uB9AC\uAC00 \uC544\uB798\uB85C
    \uD5A5\uD558\uAC8C \uB429\uB2C8\uB2E4. \uC774 \uB3D9\uC791\uC740 \uB098\uBE44\uAC00
    \uD734\uC2DD\uD560 \uB54C\uC758 \uD2B9\uC9D5\uC801\uC778 \uC790\uC138\uC785\uB2C8\uB2E4.\n\uB098\uBE44\uB4E4\uC740
    \uC8FC\uB85C \uB098\uBB47\uC78E\uC774\uB098 \uAC00\uC9C0\uC5D0 \uB9E4\uB2EC\uB824\uC11C
    \uD734\uC2DD\uC744 \uCDE8\uD558\uBA70, \uC774\uB294 \uADF8\uB4E4\uC774 \uC548\uC804\uD558\uAC8C
    \uC228\uC744 \uC218 \uC788\uB294 \uC7A5\uC18C\uB97C \uCC3E\uAE30 \uC704\uD568\uC785\uB2C8\uB2E4.
    \uD734\uC2DD \uC911\uC5D0\uB294 \uB098\uBE44\uAC00 \uAE4A\uC740 \uC218\uBA74
    \uC0C1\uD0DC\uB85C \uBE60\uC9C0\uAE30\uB3C4 \uD558\uC9C0\uB9CC, \uC77C\uBD80
    \uB098\uBE44\uB294 \uC6C0\uC9C1\uC774\uB294 \uAC83\uC774 \uC77C\uBC18\uC801\uC785\uB2C8\uB2E4.\n\n\uB098\uBE44\uC758
    \uD734\uBA74 \uC0C1\uD0DC\uC5D0\uC11C\uB294 \uB300\uBD80\uBD84\uC758 \uC2E0\uCCB4
    \uD65C\uB3D9\uC774 \uAC10\uC18C\uD558\uBA70, \uC5D0\uB108\uC9C0 \uC18C\uBE44\uB3C4
    \uC904\uC5B4\uB4ED\uB2C8\uB2E4.  \uC774 \uB3D9\uC548 \uB098\uBE44\uB294 \uD3EC\uC2DD\uC790\uB85C\uBD80\uD130
    \uC228\uC744 \uC798 \uC228\uAE30\uACE0 \uBAB8\uC744 \uBCF4\uD638\uD558\uAE30
    \uC704\uD574 \uC0C9\uAE54\uC774\uB098 \uD328\uD134\uC774 \uC788\uB294 \uB0A0\uAC1C\uB97C
    \uB2EB\uC544\uB461\uB2C8\uB2E4. \uD734\uBA74 \uC0C1\uD0DC\uC5D0\uC11C\uB3C4 \uC77C\uBD80
    \uB098\uBE44\uB4E4\uC740 \uD658\uACBD\uC758 \uBCC0\uD654\uC5D0 \uBBFC\uAC10\uD558\uAC8C
    \uBC18\uC744 \uC218 \uC788\uC73C\uBA70, \uC548\uC804\uD55C \uC7A5\uC18C\uC5D0\uC11C
    \uC7A0\uC744 \uC790\uB294 \uC2B5\uC131\uC774 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uB098\uBE44\uB4E4\uC740
    \uD2B9\uD788 \uBC24\uC5D0\uB294 \uC7A0\uC744 \uC790\uBA74\uC11C\uB3C4 \uD658\uACBD\uC5D0
    \uB300\uD55C \uACBD\uAC01\uC2EC\uC744 \uC720\uC9C0\uD569\uB2C8\uB2E4. \uB098\uBE44\uB294
    \uBC24\uC5D0 \uC228\uC744 \uC26C\uAE30 \uC704\uD574 \uB3CC\uCD9C\uB41C \uBD80\uBD84\uC774
    \uC788\uB294 \uB098\uBB47\uAC00\uC9C0\uC5D0 \uBAB8\uC744 \uBD99\uC774\uAE30\uB3C4
    \uD569\uB2C8\uB2E4. \uB610\uD55C \uB0AE \uB3D9\uC548\uC5D0\uB294 \uD587\uBE5B\uC774\uB098
    \uAE30\uD6C4 \uBCC0\uD654\uC5D0 \uB300\uBE44\uD574 \uB098\uBB47\uAC00\uC9C0\uC758
    \uADF8\uB298\uC9C4 \uACF3\uC774\uB098 \uC78E\uC0AC\uADC0 \uC0AC\uC774\uC5D0 \uC228\uC5B4\uC788\uAE30\uB3C4
    \uD569\uB2C8\uB2E4."
